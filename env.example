# Password for the SIP directory users (1000-1019) in conf/directory/default/.
FREESWITCH_PASSWORD=SET THIS!

# SignalWire Personal Access Token, used at BUILD time to reach the FreeSWITCH
# Community apt repo. Create one in your SignalWire Space under
# "Personal Access Tokens". Current tokens are prefixed pat_.
# It is passed as a build secret, never baked into the image, and is blanked in
# the container's runtime environment because it is not needed there.
SIGNALWIRE_TOKEN=GET THIS!

# What the internal SIP profile advertises in SDP.
#
#   auto-nat    correct on Linux with host networking (the default)
#   <LAN IP>    required on Docker Desktop - otherwise FreeSWITCH advertises the
#               container address (172.17.x.x) and softphones on your own
#               machine get signalling but no audio
#
# Both compose files default these to auto-nat, so leaving them unset is safe.
#FS_INTERNAL_EXT_SIP_IP=192.168.1.50
#FS_INTERNAL_EXT_RTP_IP=192.168.1.50

# Where extension 1800 sends a call - see
# conf/dialplan/default/51_signalwire_outbound.xml.
#
# Create a SIP domain application in your SignalWire Space and set
# "Handle Using" to an AI Agent or a SWML script; its address has the form
# below. Include ;transport=tcp - the domain apps expect it.
# Changing this needs a container restart, not just reloadxml.
#SIGNALWIRE_SIP_DESTINATION=MyAgent@your-space.dapp.swire.io;transport=tcp
